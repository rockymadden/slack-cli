function statusedit() {
  local _expiration=0
  if [ -n "${expires}" ]; then
    _expiration=$(lepoch "${expires}") || { lerror invalid_expires ; return 1 ; }
  fi

  local _profile=$(\
    jq -cn --arg t "${text}" --arg e "${emoji}" --argjson x "${_expiration}" \
      '{status_text: $t, status_emoji: $e, status_expiration: $x}')

  local msg=$(\
    api users.profile.set \
      --data-urlencode "profile=${_profile}")

  jqify "${msg}"
}

function version() {
  echo '0.19.0'
}

# COMMAND ROUTING #################################################################################
case "${cmd}${sub}" in
  --help|-h) help ; exit 0 ;;
  --version|-v) version ; exit 0 ;;
  init) ldeps jq || exit 1 ; init ; exit $? ;;
  chatdelete|chatsend|chatupdate|\
  filedelete|fileinfo|filelist|fileupload|\
  presenceactive|presenceaway|\
  reminderadd|remindercomplete|reminderdelete|reminderinfo|reminderlist|\
  snoozeend|snoozeinfo|snoozestart|\
  statusclear|statusedit)
    ldeps curl jq || exit 1

    # ${token:+set} keeps the token itself out of --trace output.
    if [ -z "${token:+set}" ]; then
      echo '{"ok": false, "error": "not_inited"}' |
        jq -r ${compact} ${monochrome} "${filter:=.}" ; exit 1
    fi

    ${cmd}${sub} ; exit $?
  ;;
  *) help ; exit 1 ;;
esac
