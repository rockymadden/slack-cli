function filedelete() {
  local msg=$(\
    api files.delete \
      --data-urlencode "file=${file}")

  jqify "${msg}"
}

function fileinfo() {
  local msg=$(\
    api files.info \
      ${count:+ --data-urlencode "count=${count}"} \
      --data-urlencode "file=${file}" \
      ${page:+ --data-urlencode "page=${page}"})

  jqify "${msg}"
}

function filelist() {
  local msg=$(\
    api files.list \
      ${channel:+ --data-urlencode "channel=${channel}"} \
      ${count:+ --data-urlencode "count=${count}"} \
      ${page:+ --data-urlencode "page=${page}"} \
      ${timestampfrom:+ --data-urlencode "ts_from=${timestampfrom}"} \
      ${timestampto:+ --data-urlencode "ts_to=${timestampto}"} \
      ${types:+ --data-urlencode "types=${types}"} \
      ${user:+ --data-urlencode "user=$(luser)"})

  jqify "${msg}"
}

# files.upload is retired: get an upload URL, POST the bytes there, then complete (and share) it.
function fileupload() {
  [ -n "${stdin}" ] && [ -z "${file}" ] && file=${stdin}

  local _path _filename _tmp=''
  if [ -f "${file}" ]; then
    _path=${file}
    _filename=${filename:-$(basename "${file}")}
  else
    _tmp=$(mktemp)
    printf '%s' "${file}" > "${_tmp}"
    _path=${_tmp}
    _filename=${filename:-stdin}
  fi

  local _length=$(wc -c < "${_path}" | tr -d ' ')
  local _ticket=$(\
    api files.getUploadURLExternal \
      --data-urlencode "filename=${_filename}" \
      --data-urlencode "length=${_length}" \
      ${filetype:+ --data-urlencode "snippet_type=${filetype}"})

  if [ "$(jq -r '.ok' <<< "${_ticket}" 2>/dev/null)" != 'true' ]; then
    [ -n "${_tmp}" ] && rm -f "${_tmp}"
    jqify "${_ticket}" ; return 1
  fi

  # The upload URL is pre-signed; it gets the bytes and no token.
  local _code=$(\
    curl -s -o /dev/null -w '%{http_code}' -X POST "$(jq -r '.upload_url' <<< "${_ticket}")" \
      -F "filename=@${_path}")
  [ -n "${_tmp}" ] && rm -f "${_tmp}"
  [ "${_code}" = '200' ] || { lerror upload_failed "{\"http_code\": \"${_code}\"}" ; return 1 ; }

  local _ids=''
  if [ -n "${channels}" ]; then
    _ids=$(lchannelids) || { lerror channel_not_found ; return 1 ; }
  fi

  local _files=$(\
    jq -cn --arg id "$(jq -r '.file_id' <<< "${_ticket}")" --arg title "${title:-${_filename}}" \
      '[{id: $id, title: $title}]')

  local msg=$(\
    api files.completeUploadExternal \
      --data-urlencode "files=${_files}" \
      ${_ids:+ --data-urlencode "channels=${_ids}"} \
      ${comment:+ --data-urlencode "initial_comment=${comment}"})

  jqify "${msg}"
}

function init() {
  ( umask 077 ; printf '%s\n' "${token}" > "${etcdir}/.slack" ) && chmod 600 "${etcdir}/.slack"

  case "${?}" in
    0) echo '{"ok": true}' | jq -r ${compact} ${monochrome} "${filter:=.}" ;;
    *)
      echo '{"ok": false, "error": "not_writable"}' |
        jq -r ${compact} ${monochrome} "${filter:=.}" ; return 1
    ;;
  esac
}

